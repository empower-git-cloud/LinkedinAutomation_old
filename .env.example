# --- Content intelligence (LLM) ---
# Provider-agnostic: uses the OpenAI-compatible Chat Completions API, so OpenAI,
# Groq, Together, OpenRouter, etc. all work by config alone. Without a key the app
# runs deterministic fallbacks; WITH a key, generation, theme suggestion, profile
# parsing and comment sentiment become genuinely AI-driven.
#
# Set ONE of these:
#   Groq:   LLM_API_KEY=<your key>  LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
#   OpenAI: LLM_API_KEY=<your key>  (base URL/model default to OpenAI)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Legacy OpenAI-specific vars still work as a fallback:
OPENAI_API_KEY=
OPENAI_MODEL=

# --- LinkedIn publishing (official API) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_SCOPES=openid profile email w_member_social
LINKEDIN_API_VERSION=202606

# --- Security ---
TOKEN_ENCRYPTION_KEY=
# Signs the email login session cookie. Falls back to TOKEN_ENCRYPTION_KEY if unset.
SESSION_SECRET=
CRON_SECRET=

# --- Optional external data providers (compliant, bring-your-own-key) ---
# LinkedIn has no official API for profile history or trending content. Configure a
# compliant provider (e.g. a Proxycurl-style profile API, a social-listening trends API)
# to enable profile enrichment from a URL and live trend signals. Left blank, the app
# uses your pasted profile text + first-party performance + the encoded playbook, honestly.
PROFILE_PROVIDER_URL=
PROFILE_PROVIDER_API_KEY=
TRENDS_PROVIDER_URL=
TRENDS_PROVIDER_API_KEY=
